
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <title>VHVR Gift Hub</title>

  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 30px 18px;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      text-align: center;
      color: white;
      background: linear-gradient(145deg, #111827, #312e81);
    }

    main {
      max-width: 440px;
      margin: 35px auto;
    }

    .gift { font-size: 72px; }

    h1 { font-size: 30px; }

    p {
      color: #dbeafe;
      line-height: 1.7;
    }

    .card {
      margin-top: 28px;
      padding: 24px;
      border-radius: 20px;
      background: rgba(255,255,255,.09);
      border: 1px solid rgba(255,255,255,.15);
    }

    button {
      width: 100%;
      margin-top: 16px;
      padding: 15px;
      border: 0;
      border-radius: 12px;
      background: #a5b4fc;
      color: #111827;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    #status {
      overflow-wrap: anywhere;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <main>
    <div class="gift">🎁</div>
    <h1>VHVR Gift Hub</h1>
    <p>Selamat datang di VHVR BOT!</p>

    <section class="card">
      <h2>Gift Hub</h2>
      <p>Aplikasi web VHVR Anda telah dimuat.</p>

      <button id="start">🚀 Mulai</button>
      <button id="close">Kembali ke Telegram</button>

      <p id="status">Siap digunakan.</p>
    </section>
  </main>

  <script>
    const tg = window.Telegram?.WebApp;
    const status = document.getElementById("status");

    if (tg) {
      tg.ready();
      tg.expand();
    }

    document.getElementById("start").onclick = function () {
      if (tg) {
        tg.showAlert("Selamat datang di VHVR Gift Hub!");
      } else {
        status.textContent =
          "Halaman aktif. Buka melalui Telegram untuk fitur Mini App.";
      }
    };

    document.getElementById("close").onclick = function () {
      if (tg) {
        tg.close();
      } else {
        status.textContent =
          "Silakan kembali ke Telegram secara manual.";
      }
    };
  </script>
</body>
</html>
